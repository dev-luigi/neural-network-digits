# Line endings normalized in the repository
* text=auto

# .bat files must have Windows line endings, otherwise cmd.exe can read them wrong
*.bat text eol=crlf
# .sh files must have Linux line endings, otherwise the shell cannot run them
*.sh text eol=lf

*.png binary
*.webp binary

# Left out of the release zip (only developers need them)
.github/ export-ignore
tests/ export-ignore
tools/ export-ignore
requirements-dev.txt export-ignore
pyproject.toml export-ignore
# The animation at the top of the README (7.5 MB): it is seen on GitHub, every update would download it
docs/intro.webp export-ignore
